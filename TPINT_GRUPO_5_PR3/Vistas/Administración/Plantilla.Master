<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Plantilla.master.cs" Inherits="Vistas.Administración.Plantilla" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <title>Layout de la Aplicación</title>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
    
    <style>
        /* =====================
           ESTILOS BASE (Tus estilos integrados)
        ===================== */
        body {
            font-family: Arial, sans-serif;
            background-color: #fafafa; /* Fondo claro para el área de contenido */
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex; /* Permite dividir sidebar y contenido */
        }

        /* =====================
           LAYOUT PRINCIPAL (Nuevo)
        ===================== */
        #form1 {
            display: flex;
            width: 100%;
            min-height: 100vh;
        }

        /* -- SIDEBAR -- */
        .sidebar {
            width: 250px;
            background-color: #1a2332; /* Usa tu color oscuro */
            color: #ffffff;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        }

        .sidebar-logo {
            padding: 24px 16px;
            text-align: center;
            background-color: #111722;
        }

        .sidebar-logo img {
            width: 60px;
            height: 60px;
            margin-bottom: 10px;
            border-radius: 8px; /* Opcional */
        }

        .sidebar-logo h2 {
            margin: 0;
            font-size: 18px;
            color: #ffffff;
        }

        .sidebar-menu {
            flex-grow: 1;
            padding: 16px 0;
        }

        /* Estilización del componente <asp:Menu> */
        .menu-asp ul { padding: 0; margin: 0; width: 100%; }
        .menu-asp li { width: 100%; list-style: none; }
        .menu-asp a {
            display: block;
            padding: 14px 24px;
            color: #cccccc !important;
            text-decoration: none;
            font-size: 14px;
            border-left: 4px solid transparent;
            transition: all 0.2s ease-in-out;
        }
        .menu-asp a:hover, .menu-asp a.selected {
            background-color: #0C447C !important;
            color: #ffffff !important;
            border-left-color: #185FA5; /* Usa tu azul principal */
        }

        /* -- ACCESO DE USUARIO (Abajo) -- */
        .sidebar-user {
            padding: 16px;
            background-color: #111722;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-user img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
        }

        .user-info { display: flex; flex-direction: column; }
        .user-info .nombre { font-size: 13px; font-weight: bold; color: #ffffff; margin-bottom: 4px; }
        .user-info a { font-size: 11px; color: #185FA5; text-decoration: none; }
        .user-info a:hover { text-decoration: underline; }

        /* -- ZONA DE CONTENIDO -- */
        .contenido-principal {
            flex-grow: 1;
            padding: 32px;
            overflow-y: auto;
            display: flex;
            justify-content: center;
            align-items: flex-start; /* Para que las cards no se queden en el centro vertical */
        }

        /* =====================
           TUS COMPONENTES (Intactos)
        ===================== */
        .contenedor { width: 100%; max-width: 380px; padding: 16px; }
        .encabezado { text-align: center; margin-bottom: 24px; }
        .encabezado h1 { font-size: 20px; color: #1a2332; margin: 0 0 4px 0; }
        .encabezado p { font-size: 13px; color: #666666; margin: 0; }
        .card { background-color: #ffffff; border: 1px solid #cccccc; border-radius: 8px; padding: 24px; }
        .campo { margin-bottom: 16px; }
        .campo label { display: block; font-size: 13px; color: #333333; margin-bottom: 5px; }
        .campo input[type="text"], .campo input[type="password"] {
            width: 100%; height: 38px; padding: 0 10px; font-size: 14px;
            border: 1px solid #cccccc; border-radius: 5px; box-sizing: border-box;
            color: #1a2332; background-color: #fafafa;
        }
        .campo input:focus { outline: none; border-color: #185FA5; background-color: #ffffff; }
        .validador { font-size: 12px; color: #cc0000; margin-top: 4px; display: block; }
        .boton-ingresar {
            width: 100%; height: 40px; background-color: #185FA5; color: #ffffff;
            border: none; border-radius: 5px; font-size: 14px; cursor: pointer;
        }
        .boton-ingresar:hover { background-color: #0C447C; }
        .pie { text-align: center; margin-top: 16px; font-size: 11px; color: #999999; }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        
        <!-- MENU -->
        <div class="sidebar">
            <div class="sidebar-logo">
                <h2>Clínica</h2>
            </div>

            <div class="sidebar-menu">
                <!-- MENU CONTROL -->
                <asp:Menu ID="MenuPrincipal" runat="server" Orientation="Vertical" RenderingMode="List" CssClass="menu-asp">
                    <Items>
                        <asp:MenuItem Text="Inicio" NavigateUrl="~/Administración/Inicio.aspx" />
                        <asp:MenuItem Text="Medicos" NavigateUrl="~/Administración/Medicos/Medicos.aspx" />
                        <asp:MenuItem Text="Usuarios" NavigateUrl="~/Administración/Usuarios/Usuarios.aspx" />
                    </Items>
                </asp:Menu>
            </div>

            <!-- ACCESO DE USUARIO -->
            <div class="sidebar-user">
                <div class="user-info">
                    <asp:Label ID="lblUserName" runat="server" CssClass="nombre" Text="Administrador"></asp:Label>
                    <asp:LoginStatus ID="LoginStatusMaster" runat="server" LogoutText="Cerrar Sesión" />
                </div>
            </div>
        </div>

        <!-- ZONA DE CONTENIDO (Cambia según el ítem clickeado) -->
        <div class="contenido-principal">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
                <!-- Aquí se inyectan las páginas hijas -->
            </asp:ContentPlaceHolder>
        </div>

    </form>
</body>
</html>